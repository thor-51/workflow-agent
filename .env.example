# Copy to .env and adjust. Never commit .env.
APP_NAME=workflow-agent
APP_ENV=development          # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=json              # json | console

# Added in later phases (documented here so the config surface is visible)
DATABASE_URL=sqlite:///./workflow_agent.db   # Postgres later: postgresql+psycopg://user:pass@host:5432/db
